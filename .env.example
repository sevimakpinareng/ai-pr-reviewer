# Copy to ".env" and adjust. ".env" is gitignored and must never be committed.

# ---- Spring app: how the application connects to Postgres ----
DB_URL=jdbc:postgresql://localhost:5432/prreviewer
DB_USER=prreviewer
DB_PASSWORD=prreviewer

# ---- docker-compose: how the Postgres container initializes itself ----
# Keep these in sync with the DB_* values above.
POSTGRES_DB=prreviewer
POSTGRES_USER=prreviewer
POSTGRES_PASSWORD=prreviewer
# Host port the container publishes on. Change it (e.g. 5433) if you already
# run a local Postgres on 5432; then update DB_URL above to match.
POSTGRES_PORT=5432

# ---- RabbitMQ (async work queue) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=prreviewer
RABBITMQ_PASSWORD=prreviewer
# Management UI host port (http://localhost:15672)
RABBITMQ_MGMT_PORT=15672
# Consumer concurrency (min/max listeners)
RABBITMQ_CONCURRENCY_MIN=1
RABBITMQ_CONCURRENCY_MAX=3

# ---- Redis (dedupe / superseding / rate limiting) ----
REDIS_HOST=localhost
REDIS_PORT=6379
# Dedupe / superseding key lifetimes
DEDUPE_TTL=6h
SUPERSEDE_TTL=2d
# Rate limit: N reviews per installation per window
RATELIMIT_LIMIT=30
RATELIMIT_WINDOW=1m
RATELIMIT_REQUEUE_DELAY=500ms

# ---- Outbound HTTP timeouts ----
GITHUB_CONNECT_TIMEOUT=5s
GITHUB_READ_TIMEOUT=15s
LLM_CONNECT_TIMEOUT=5s
LLM_READ_TIMEOUT=120s

# ---- Observability ----
# Use SPRING_PROFILES_ACTIVE=prod for JSON structured logs (plain text otherwise).

# ---- GitHub webhook ----
# Shared secret configured on the GitHub App / webhook. Incoming deliveries are
# rejected (401) unless their X-Hub-Signature-256 matches an HMAC-SHA256 of the
# raw body computed with this secret. Use a long random value in real setups.
GITHUB_WEBHOOK_SECRET=changeme

# ---- GitHub App (for authenticating to the GitHub API) ----
# Numeric App ID from the GitHub App settings page.
GITHUB_APP_ID=123456
# Filesystem path to the App's private key (.pem). The file is gitignored and
# must NOT be committed. PKCS#1 ("BEGIN RSA PRIVATE KEY", GitHub's default) and
# PKCS#8 ("BEGIN PRIVATE KEY") are both accepted.
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Optional: override the API base URL (e.g. GitHub Enterprise).
# GITHUB_API_BASE_URL=https://api.github.com

# ---- AI review (Spring AI) ----
# Default provider is local Ollama (free for dev). To use Mistral instead, set
# SPRING_PROFILES_ACTIVE=mistral and provide MISTRAL_API_KEY.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Only used with the "mistral" profile:
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Review tuning (shared by both providers):
REVIEW_TEMPERATURE=0.1
REVIEW_MAX_DIFF_CHARS=12000
REVIEW_SEVERITY_THRESHOLD=WARNING
REVIEW_MAX_FINDINGS=10
REVIEW_MAX_FILES=20
# Post a short "no issues" review when nothing was found (false = stay silent).
REVIEW_POST_EMPTY=true
