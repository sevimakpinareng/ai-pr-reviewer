# Copy to ".env" and adjust. ".env" is gitignored and must never be committed.

# ---- Spring app: how the application connects to Postgres ----
DB_URL=jdbc:postgresql://localhost:5432/prreviewer
DB_USER=prreviewer
DB_PASSWORD=prreviewer

# ---- docker-compose: how the Postgres container initializes itself ----
# Keep these in sync with the DB_* values above.
POSTGRES_DB=prreviewer
POSTGRES_USER=prreviewer
POSTGRES_PASSWORD=prreviewer
# Host port the container publishes on. Change it (e.g. 5433) if you already
# run a local Postgres on 5432; then update DB_URL above to match.
POSTGRES_PORT=5432

# ---- GitHub webhook ----
# Shared secret configured on the GitHub App / webhook. Incoming deliveries are
# rejected (401) unless their X-Hub-Signature-256 matches an HMAC-SHA256 of the
# raw body computed with this secret. Use a long random value in real setups.
GITHUB_WEBHOOK_SECRET=changeme
