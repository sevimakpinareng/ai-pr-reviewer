<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Local/default: human-readable text, with the correlation ids from MDC
        (deliveryId / repo / pr / reviewId) shown inline.
        Prod: JSON (logstash encoder) which includes all MDC fields as top-level
        keys for log aggregation.
    -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] [d=%X{deliveryId:-} %X{repo:-}#%X{prNumber:-} review=%X{reviewId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>deliveryId</includeMdcKeyName>
                <includeMdcKeyName>repo</includeMdcKeyName>
                <includeMdcKeyName>prNumber</includeMdcKeyName>
                <includeMdcKeyName>commitSha</includeMdcKeyName>
                <includeMdcKeyName>reviewId</includeMdcKeyName>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
